# CSET — DocumentRoot /tv (/var/www/html/tv): index.html = cartelera Signage (Play via URL → /tv/).
# Sin esto, LG Signage cachea el HTML viejo y el AJAX de refresco nunca llega al monitor.
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
