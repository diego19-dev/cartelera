# Copiar a .env y completar con valores reales — .env NUNCA se commitea (ver .gitignore)

# Base de datos
DB_HOST=10.5.213.103
DB_PORT=5432
DB_NAME=db_cset
DB_USER=cset_app
DB_PASS=

# Aplicación
APP_ENV=production
APP_URL=http://10.5.213.103/tv

# Clave secreta (usar: php -r "echo bin2hex(random_bytes(32));")
SECRET_KEY=

# Solo activar en 1 si hay un proxy reverso de confianza delante de Apache
# (si no, cualquier cliente puede falsificar su IP vía X-Forwarded-For)
TRUST_PROXY=0

# Rate limiting de login (E3)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Cookie de sesión "Secure" — poner en 1 SOLO cuando TLS esté sirviendo /tv (E4).
# Con 1 y sin HTTPS, el navegador nunca envía la cookie y el login se rompe.
COOKIE_SECURE=0
